# Video segmentation head (Cutie port): ml-base:dev plus Cutie's missing dependencies. The base image is unchanged;
# runs that need these set IMAGE=ml-base:vos for scripts/run.sh.
FROM ml-base:dev
RUN uv pip install --system --break-system-packages opencv-python-headless==4.10.0.84 gitpython==3.1.43 hickle==5.0.3 easydict==1.13 \
    "thinplate @ git+https://github.com/cheind/py-thin-plate-spline@f6995795397118b7d0ac01aecd3f39ffbfad9dee"
